PORT=5000
NODE_ENV=development

# PostgreSQL (local)
# Replace user/password/dbname with your local postgres setup.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maati_ai

# JWT (set your own secret)
JWT_SECRET=change_me

# Cloudinary (for traceability camera uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mongo (if used elsewhere in the app)
MONGO_URI=mongodb://localhost:27017/maati_ai
